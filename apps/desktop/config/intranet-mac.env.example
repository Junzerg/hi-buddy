# Copy into apps/desktop/.env.macos for signed notarized Mac intranet packaging.
# Feed directory must match the packaging arch (mac-arm64 or mac-x64).
DSH_DESKTOP_APP_ID=com.deepseek.dsh
DSH_DESKTOP_INTRANET_UPDATE_URL=http://172.28.236.3:18765/updates/mac-arm64/

DSH_DESKTOP_MACOS_PACK_CONCURRENCY=4
DSH_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3

DSH_DESKTOP_MACOS_SIGNING_IDENTITY=
DSH_DESKTOP_MACOS_TEAM_ID=
CSC_LINK=
CSC_KEY_PASSWORD=

# Choose exactly one notarization strategy; intranet Mac updates reject --skip-notarization.
# APPLE_API_KEY=
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
