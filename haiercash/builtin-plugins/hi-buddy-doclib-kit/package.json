{
  "name": "@local/dsh-plugin-doclib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Two-level local document library for DeepSeek Harness: workspace -> session -> the documents that session uploaded or produced. Exposes doc_search / doc_list / doc_status tools and renders a browsing tree in the Web UI.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "shared/*.js",
    "sources/*.js",
    "index/*.js",
    "search/*.js",
    "store/*.js",
    "tools/*.js",
    "http/*.js"
  ],
  "scripts": {
    "eval": "node scripts/eval.mjs",
    "check": "node scripts/check-incremental.mjs",
    "golden:record": "node scripts/golden.mjs --record",
    "golden:check": "node scripts/golden.mjs --check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
