    { "query": "turn and step lifecycle", "expect": "agent-lifecycle.md" },
    { "query": "插件配置", "expect": "config-catalog.zh.md" },
    { "query": "cordis primer", "expect": "cordis-primer.md" },
    { "query": "tool execution pipeline", "expect": "tool-execution-pipeline.md" },
    { "query": "文档图", "expect": "graph-atlas.zh.md" },
    { "query": "设置卡片", "expect": "web-styling.zh.md" },
